      - name: Commit otomatis aturan, riwayat radar & README
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add rules/ .github/nomor_radar_seen.json .github/discovered_channels.json README.md last-run.txt
          if ! git diff --staged --quiet; then
            git commit -m "chore(radar): auto-add nomor penipu & kanal baru [skip ci]"
            for i in 1 2 3; do
              if git pull --rebase origin "${GITHUB_REF_NAME}" && git push; then
                exit 0
              fi
              git rebase --abort 2>/dev/null || true
              sleep 5
            done
            exit 1
          fi
